# Copy to .env and fill in. Never commit .env.
ALPHAVANTAGE_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FRED_API_KEY=
# SEC asks for a contact string, e.g. "Your Name your.email@example.com"
SEC_USER_AGENT=

# Where datasets are read from / written to (default: ./data)
QR_DATA_DIR=
# Root for legacy desk-relative paths (default: .)
QR_DESK_DIR=
# Scratch space for intermediate files (default: $TMPDIR/qr_scratch)
QR_SCRATCH_DIR=
